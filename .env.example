# kie.ai API Configuration
KIE_AI_API_KEY=your_api_key_here

# kie.ai API endpoints
KIE_AI_BASE_URL=https://api.kie.ai

# ElevenLabs API Key — text-to-speech (voices). Required for the Edit voice step.
ELEVENLABS_API_KEY=

# OpenRouter API Key — text/vision LLM calls (prompts, motion analysis, tagging).
OPENROUTER_API_KEY=
# Optional: override the default OpenRouter text model.
OPENROUTER_TEXT_MODEL=

# Groq API Key (for Whisper speech-to-text, free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Replicate API token — image generation (nano-banana-2, gpt-image-2,
# seedream-5-lite, qwen-image-edit-plus) goes through Replicate. kie.ai stays
# for video and chat only.
REPLICATE_API_TOKEN=

# Server
PORT=3000

# Public host base URL for serving uploaded buffers to kie.ai (image-to-image
# models pull the image from a public URL). When set, this is tried first by
# uploadToPublicHost() before falling back to tmpfiles.org / uguu.se / etc.
# Leave empty in local development — the free hosts will be used instead.
# Example: PUBLIC_HOST_URL=http://203.0.113.10:3000
PUBLIC_HOST_URL=
