# UGC Studio - an optional .env, kept in the library folder: beside the exe in the desktop build,
# local-data/ when the app runs from source. Everything here may be left out.
#
# The API keys are normally entered on the Admin page and saved to data/settings.json in the
# library. A key set here is used when settings.json has none.

# The port the app serves on. Default 3000.
PORT=

# kie.ai - video, avatars, the balance counter.
KIE_AI_API_KEY=

# OpenRouter - text and vision analysis, script writing, long-video transcription.
OPENROUTER_API_KEY=
# Optional: override the default OpenRouter text model.
OPENROUTER_TEXT_MODEL=

# Replicate - image generation (nano-banana-2, gpt-image-2, seedream-5-lite, qwen-image-edit-plus).
REPLICATE_API_TOKEN=

# ElevenLabs - text-to-speech and Voice Design.
ELEVENLABS_API_KEY=

# Groq - Whisper speech-to-text for subtitles.
GROQ_API_KEY=

# Cloudflare R2 - where reference images and clips are hosted so the providers can fetch them.
# Without R2_PUBLIC_BASE the app signs a temporary link instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# yt-dlp, for sources that arrive as a link, ships with the app (vendor/yt-dlp, put there by
# npm install) and updates itself into the library. Set this only to run a different one.
YTDLP_PATH=
