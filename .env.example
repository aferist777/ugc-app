# kie.ai API Configuration
KIE_AI_API_KEY=your_api_key_here

# kie.ai API endpoints
KIE_AI_BASE_URL=https://api.kie.ai

# ElevenLabs API Key — text-to-speech (voices). Required for the Edit voice step.
ELEVENLABS_API_KEY=

# OpenRouter API Key — text/vision LLM calls (prompts, motion analysis, tagging).
OPENROUTER_API_KEY=
# Optional: override the default OpenRouter text model.
OPENROUTER_TEXT_MODEL=

# Groq API Key (for Whisper speech-to-text, free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# imgbb API key (free at https://api.imgbb.com → "Get API Key"). Used by
# uploadToPublicHost() as the primary external image host — direct i.ibb.co CDN
# links with 1h auto-expiry. Reliable on restrictive networks where small file
# hosts fail. Optional; left empty the host is skipped.
IMGBB_API_KEY=

# Replicate API token — image generation (nano-banana-2, gpt-image-2,
# seedream-5-lite, qwen-image-edit-plus) goes through Replicate. kie.ai stays
# for video and chat only.
REPLICATE_API_TOKEN=

# Server
PORT=3000

# ── Access gate (lib/access-gate.js) ─────────────────────────────────────────
# The whole app sits behind one shared password: /login sets a signed session cookie
# held per browser, then logs the user out when it expires. REQUIRED in any public
# deploy — this is what stops the open internet from reading data/settings.json via
# /api/settings (how the keys leaked once). Leave APP_PASSWORD empty and the gate is
# OFF (a loud warning prints on boot) — fine for local dev only.
APP_PASSWORD=
# Session lifetime in hours (default 6).
SESSION_HOURS=6
# Optional: explicit HMAC secret for signing cookies. If unset it is derived from
# APP_PASSWORD, so changing the password invalidates every existing session.
APP_SECRET=
# Set to 1 ONLY when the app is served over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=

# Public host base URL for serving uploaded buffers to kie.ai (image-to-image
# models pull the image from a public URL). When set, this is tried first by
# uploadToPublicHost() before falling back to tmpfiles.org / uguu.se / etc.
# Leave empty in local development — the free hosts will be used instead.
# Example: PUBLIC_HOST_URL=http://203.0.113.10:3000
PUBLIC_HOST_URL=
