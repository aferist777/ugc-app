# UGC Studio - an optional .env, kept in the library folder: beside the exe in the desktop build,
# local-data/ when the app runs from source. Everything here may be left out.
#
# The API keys are entered on Admin -> API keys and saved to data/settings.json in the library;
# none is read from here. R2 is set up there too, by the one Cloudflare key.

# The port the app serves on. Default 3000.
PORT=

# yt-dlp, for sources that arrive as a link, ships with the app (vendor/yt-dlp, put there by
# npm install) and updates itself into the library. Set this only to run a different one.
YTDLP_PATH=
