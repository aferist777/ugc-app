node_modules/
.env
# Binaries the app ships but does not keep in git: yt-dlp, fetched by tools/fetch-yt-dlp.js.
/vendor/
# The library when the app runs from source (lib/config.js): everything it writes.
local-data/
# The library UGC Studio.cmd opens. Rooted: public/js/library/ is code.
/library/
*.log
*.zip
# ...except the built-in sound set: kept in git, laid out by tools/fetch-sfx.js.
!/tools/sfx/*.zip
# ...and the built-in pattern set: kept in git the same way, laid out by tools/fetch-patterns.js.
!/tools/patterns/*.zip
# Claude Code's local settings and preview launch configurations.
.claude/
